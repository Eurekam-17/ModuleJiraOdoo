<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Jira is the source of truth: no create / edit / delete in Odoo. -->
    <record id="jira_issue_view_list" model="ir.ui.view">
        <field name="name">jira.issue.list</field>
        <field name="model">jira.issue</field>
        <field name="arch" type="xml">
            <list string="Tickets Jira" create="0" edit="0" delete="0"
                  decoration-muted="not is_open">
                <field name="key"/>
                <field name="project_id" optional="hide"/>
                <field name="issue_type"/>
                <field name="summary"/>
                <field name="status"/>
                <field name="status_category" widget="badge"
                       decoration-info="status_category == 'new'"
                       decoration-warning="status_category == 'indeterminate'"
                       decoration-success="status_category == 'done'"/>
                <field name="priority" optional="show"/>
                <field name="fix_version_ids" widget="many2many_tags" optional="show"/>
                <field name="sprint_id" optional="hide"/>
                <field name="epic_key" optional="hide"/>
                <field name="work_nature" optional="show"/>
                <field name="is_assigned" optional="hide"/>
                <field name="created_at" optional="show"/>
                <field name="updated_at" optional="hide"/>
                <field name="resolved_at" optional="show"/>
                <field name="is_open" optional="hide"/>
                <field name="is_delivered" optional="hide"/>
                <field name="lead_time_days" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="jira_issue_view_form" model="ir.ui.view">
        <field name="name">jira.issue.form</field>
        <field name="model">jira.issue</field>
        <field name="arch" type="xml">
            <form string="Ticket Jira" create="0" edit="0" delete="0">
                <header>
                    <field name="status_category" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1><field name="key"/></h1>
                        <h2><field name="summary"/></h2>
                    </div>
                    <group>
                        <group string="Ticket">
                            <field name="project_id"/>
                            <field name="issue_type"/>
                            <field name="status"/>
                            <field name="priority"/>
                            <field name="resolution"/>
                            <field name="url" widget="url"/>
                        </group>
                        <group string="Planification">
                            <field name="fix_version_ids" widget="many2many_tags"/>
                            <field name="sprint_id"/>
                            <field name="work_nature"/>
                            <field name="epic_key"/>
                            <field name="parent_key"/>
                            <field name="components"/>
                            <field name="labels"/>
                            <field name="is_assigned"/>
                        </group>
                        <group string="Dates">
                            <field name="created_at"/>
                            <field name="updated_at"/>
                            <field name="resolved_at"/>
                            <field name="due_date"/>
                        </group>
                        <group string="Indicateurs">
                            <field name="is_open"/>
                            <field name="is_declined"/>
                            <field name="is_delivered"/>
                            <field name="lead_time_days"/>
                            <field name="active"/>
                            <field name="last_synced_at"/>
                        </group>
                    </group>
                    <!-- Placed after "active" (Odoo 18: a field must be declared
                         before a modifier uses it); the ribbon is positioned
                         top-right by CSS anyway. -->
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="jira_issue_view_search" model="ir.ui.view">
        <field name="name">jira.issue.search</field>
        <field name="model">jira.issue</field>
        <field name="arch" type="xml">
            <search string="Tickets Jira">
                <field name="key" string="Clé ou titre"
                       filter_domain="['|', ('key', 'ilike', self), ('summary', 'ilike', self)]"/>
                <field name="project_id"/>
                <field name="fix_version_ids"/>
                <field name="sprint_id"/>
                <field name="epic_key"/>
                <field name="work_nature"/>
                <field name="issue_type"/>
                <field name="status"/>
                <field name="labels"/>
                <field name="components"/>
                <filter name="filter_open" string="Ouverts" domain="[('is_open', '=', True)]"/>
                <filter name="filter_open_bugs" string="Anomalies ouvertes"
                        domain="[('is_open', '=', True), ('issue_type', '=', 'Bug')]"/>
                <filter name="filter_delivered_12m" string="Livrés sur 12 mois"
                        domain="[('is_delivered', '=', True), ('resolved_at', '>=', (context_today() - relativedelta(days=365)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_no_version" string="Sans version cible"
                        domain="[('fix_version_ids', '=', False)]"/>
                <filter name="filter_open_1y" string="Ouverts depuis plus d'un an"
                        domain="[('is_open', '=', True), ('created_at', '&lt;', (context_today() - relativedelta(days=365)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_delivered" string="Livrés" domain="[('is_delivered', '=', True)]"/>
                <filter name="filter_declined" string="Déclinés" domain="[('is_declined', '=', True)]"/>
                <separator/>
                <filter name="filter_no_nature" string="Sans nature du travail"
                        domain="[('work_nature', '=', False)]"/>
                <separator/>
                <filter name="filter_da_dc" string="Projets DA et DC"
                        domain="[('project_id.key', 'in', ['DA', 'DC'])]"/>
                <separator/>
                <filter name="filter_archived" string="Archivés (disparus de Jira)"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_project" string="Projet" context="{'group_by': 'project_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'issue_type'}"/>
                    <filter name="group_status" string="Statut" context="{'group_by': 'status'}"/>
                    <filter name="group_category" string="Catégorie de statut"
                            context="{'group_by': 'status_category'}"/>
                    <filter name="group_priority" string="Priorité" context="{'group_by': 'priority'}"/>
                    <filter name="group_version" string="Version cible"
                            context="{'group_by': 'fix_version_ids'}"/>
                    <filter name="group_sprint" string="Sprint" context="{'group_by': 'sprint_id'}"/>
                    <filter name="group_epic" string="Épopée" context="{'group_by': 'epic_key'}"/>
                    <filter name="group_nature" string="Nature du travail"
                            context="{'group_by': 'work_nature'}"/>
                    <filter name="group_created" string="Mois de création"
                            context="{'group_by': 'created_at:month'}"/>
                    <filter name="group_resolved" string="Mois de résolution"
                            context="{'group_by': 'resolved_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="jira_issue_view_pivot" model="ir.ui.view">
        <field name="name">jira.issue.pivot</field>
        <field name="model">jira.issue</field>
        <field name="arch" type="xml">
            <pivot string="Tickets Jira" sample="1">
                <field name="project_id" type="row"/>
                <field name="status_category" type="col"/>
                <!-- No explicit measure: the pivot counts tickets by default.
                     The delay is only set on delivered tickets, so it is left
                     to the « Mesures » menu (use it with the « Livrés » filter). -->
            </pivot>
        </field>
    </record>

    <record id="jira_issue_view_graph" model="ir.ui.view">
        <field name="name">jira.issue.graph</field>
        <field name="model">jira.issue</field>
        <field name="arch" type="xml">
            <graph string="Tickets Jira" type="bar" stacked="1" sample="1">
                <field name="project_id"/>
                <field name="status_category"/>
            </graph>
        </field>
    </record>

    <record id="action_jira_issue" model="ir.actions.act_window">
        <field name="name">Tickets Jira</field>
        <field name="res_model">jira.issue</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="jira_issue_view_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun ticket Jira synchronisé</p>
            <p>Les tickets sont copiés depuis Jira par la synchronisation planifiée
               (Configuration &gt; Paramètres).</p>
        </field>
    </record>
</odoo>
