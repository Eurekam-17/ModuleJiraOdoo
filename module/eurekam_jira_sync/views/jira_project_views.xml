<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Only "Synchronisé" and the board can be changed (administrators). -->
    <record id="jira_project_view_list" model="ir.ui.view">
        <field name="name">jira.project.list</field>
        <field name="model">jira.project</field>
        <field name="arch" type="xml">
            <list string="Projets Jira" create="0" delete="0" editable="bottom">
                <field name="key"/>
                <field name="name"/>
                <field name="jira_id" optional="hide"/>
                <field name="sync_enabled"/>
                <field name="board_id" optional="show"/>
                <field name="issue_count"/>
            </list>
        </field>
    </record>

    <record id="action_jira_project" model="ir.actions.act_window">
        <field name="name">Projets Jira</field>
        <field name="res_model">jira.project</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun projet Jira</p>
            <p>Les projets listés dans les paramètres (DA, DC, DP par défaut) sont
               créés à la première synchronisation.</p>
        </field>
    </record>
</odoo>
